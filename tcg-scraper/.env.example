APITCG_API_KEY=your-apitcg-api-key
APITCG_BASE_URL=https://api.apitcg.com/api
APITCG_AUTH_HEADER=x-api-key
APITCG_MAX_CALLS_PER_MINUTE=30
# apitcg's real constraint is a MONTHLY quota (1,000/month on the free tier),
# not a per-minute burst - this is an in-process soft guard, resets on
# container restart, see apitcg/client.py.
APITCG_MONTHLY_CALL_LIMIT=950
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=moondream
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_MAX_IMAGE_DIMENSION=1024
APP_PORT=9096
