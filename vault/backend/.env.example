DATABASE_URL=postgresql://comicvault:comicvault@localhost:5432/comicvault
# Optional - read-only lookup against gcd-modifier's database. Leave blank to
# skip GCD lookups entirely and fall back to Metron/ComicVine as before.
GCD_DATABASE_URL=postgresql://comicvault:comicvault@localhost:5432/gcd
JWT_SECRET=changeme-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=5
JWT_KIOSK_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3002
COMIC_SCRAPER_URL=http://comic-scraper:9095
COMICVINE_API_KEY=
TCG_SCRAPER_URL=http://tcg-scraper:9096
