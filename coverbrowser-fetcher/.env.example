POSTGRES_USER=comicvault
POSTGRES_PASSWORD=comicvault
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=coverbrowser

# Read-only - same gcd-modifier database the main backend already queries.
GCD_DATABASE_URL=postgresql+psycopg://comicvault:comicvault@postgres:5432/gcd

# Identify the job honestly - this is scraping a small hobby site with no
# published API, not a service built to take load.
USER_AGENT=ComicVault-CoverbrowserFetcher/0.1 (personal self-hosted comic catalog)
REQUEST_DELAY_SECONDS=2.5
