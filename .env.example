# Copy to .env (gitignored, auto-loaded by docker-compose)

JWT_SECRET=changeme-use-a-long-random-string

# Password for the permanent "kiosk" account (auto-created on backend startup if missing)
KIOSK_PASSWORD=changeme-do-not-use-the-default-in-production

# Metron API credentials (metron.cloud) for the comic-scraper barcode lookup service
METRON_USERNAME=your-metron-username
METRON_PASSWORD=your-metron-password
