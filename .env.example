# Copy to .env (gitignored, auto-loaded by docker-compose)

JWT_SECRET=changeme-use-a-long-random-string

# Password for the permanent "kiosk" account (auto-created on backend startup if missing)
KIOSK_PASSWORD=changeme-do-not-use-the-default-in-production

# Metron API credentials (metron.cloud) for the comic-scraper barcode lookup service
METRON_USERNAME=your-metron-username
METRON_PASSWORD=your-metron-password

# apitcg.com API key for the tcg-scraper trading card catalog sync
APITCG_API_KEY=your-apitcg-api-key

# Local Ollama vision model used for card photo identification - small/CPU-friendly
# by default, swap to something bigger once a GPU is available (docker-compose.yml)
OLLAMA_VISION_MODEL=moondream

# comics.org account credentials for the gcd-modifier service, which logs in
# to download the Grand Comics Database dump on a schedule
GCD_USERNAME=your-comics-org-username
GCD_PASSWORD=your-comics-org-password
