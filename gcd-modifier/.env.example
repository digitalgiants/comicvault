# Copy to .env (gitignored, auto-loaded by docker-compose)

# comics.org account credentials, used to log in and download the GCD SQLite dump
GCD_USERNAME=your-comics-org-username
GCD_PASSWORD=your-comics-org-password

POSTGRES_USER=comicvault
POSTGRES_PASSWORD=comicvault
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gcd
